<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="work-order"
              pageWidth="595"
              pageHeight="842"
              columnWidth="555"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20">
    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="10"
           pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
    <style name="BaseBold" fontName="DejaVu Sans" fontSize="10" isBold="true"
           pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
    <style name="Title" fontName="DejaVu Sans" fontSize="18" isBold="true"
           pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
    <style name="Section" fontName="DejaVu Sans" fontSize="12" isBold="true"
           pdfFontName="DejaVu Sans" pdfEncoding="Identity-H" isPdfEmbedded="true"/>
    <parameter name="reportTitle" class="java.lang.String"/>
    <parameter name="labelWorkOrder" class="java.lang.String"/>
    <parameter name="labelPurchaseOrder" class="java.lang.String"/>
    <parameter name="labelBuyerId" class="java.lang.String"/>
    <parameter name="labelProduct" class="java.lang.String"/>
    <parameter name="labelProductQuantity" class="java.lang.String"/>
    <parameter name="labelStockAssignedQuantity" class="java.lang.String"/>
    <parameter name="labelDueDate" class="java.lang.String"/>
    <parameter name="labelStartDate" class="java.lang.String"/>
    <parameter name="labelEndDate" class="java.lang.String"/>
    <parameter name="labelComment" class="java.lang.String"/>
    <parameter name="labelMaterialsTitle" class="java.lang.String"/>
    <parameter name="labelMaterialCode" class="java.lang.String"/>
    <parameter name="labelMaterialName" class="java.lang.String"/>
    <parameter name="labelQuantity" class="java.lang.String"/>
    <parameter name="noMaterials" class="java.lang.String"/>
    <parameter name="labelTechnologyTitle" class="java.lang.String"/>
    <parameter name="technologyText" class="java.lang.String"/>
    <parameter name="labelMachineTitle" class="java.lang.String"/>
    <parameter name="machineText" class="java.lang.String"/>
    <parameter name="showMachineSection" class="java.lang.Boolean"/>
    <parameter name="workOrderId" class="java.lang.String"/>
    <parameter name="purchaseOrderNumber" class="java.lang.String"/>
    <parameter name="buyerId" class="java.lang.String"/>
    <parameter name="productLine" class="java.lang.String"/>
    <parameter name="productQuantity" class="java.lang.String"/>
    <parameter name="stockAssignedQuantity" class="java.lang.String"/>
    <parameter name="dueDate" class="java.lang.String"/>
    <parameter name="startDate" class="java.lang.String"/>
    <parameter name="endDate" class="java.lang.String"/>
    <parameter name="comment" class="java.lang.String"/>
    <parameter name="hasMaterials" class="java.lang.Boolean"/>
    <field name="materialCode" class="java.lang.String"/>
    <field name="materialName" class="java.lang.String"/>
    <field name="requiredQuantity" class="java.lang.String"/>
    <title>
        <band height="50">
            <textField>
                <reportElement x="0" y="10" width="555" height="30" style="Title"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[$P{reportTitle}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <pageHeader>
        <band height="210">
            <textField>
                <reportElement x="0" y="0" width="250" height="18" style="BaseBold"/>
                <textFieldExpression><![CDATA[$P{labelWorkOrder} + ":"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="250" y="0" width="305" height="18"/>
                <textFieldExpression><![CDATA[$P{workOrderId}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="20" width="250" height="18" style="BaseBold"/>
                <textFieldExpression><![CDATA[$P{labelPurchaseOrder} + ":"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="250" y="20" width="305" height="18"/>
                <textFieldExpression><![CDATA[$P{purchaseOrderNumber}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="40" width="250" height="18" style="BaseBold"/>
                <textFieldExpression><![CDATA[$P{labelBuyerId} + ":"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="250" y="40" width="305" height="18"/>
                <textFieldExpression><![CDATA[$P{buyerId}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="60" width="250" height="18" style="BaseBold"/>
                <textFieldExpression><![CDATA[$P{labelProduct} + ":"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="250" y="60" width="305" height="18"/>
                <textFieldExpression><![CDATA[$P{productLine}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="80" width="250" height="18" style="BaseBold"/>
                <textFieldExpression><![CDATA[$P{labelProductQuantity} + ":"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="250" y="80" width="305" height="18"/>
                <textFieldExpression><![CDATA[$P{productQuantity}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="100" width="250" height="18" style="BaseBold"/>
                <textFieldExpression><![CDATA[$P{labelStockAssignedQuantity} + ":"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="250" y="100" width="305" height="18"/>
                <textFieldExpression><![CDATA[$P{stockAssignedQuantity}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="120" width="250" height="18" style="BaseBold"/>
                <textFieldExpression><![CDATA[$P{labelDueDate} + ":"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="250" y="120" width="305" height="18"/>
                <textFieldExpression><![CDATA[$P{dueDate}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="140" width="250" height="18" style="BaseBold"/>
                <textFieldExpression><![CDATA[$P{labelStartDate} + ":"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="250" y="140" width="305" height="18"/>
                <textFieldExpression><![CDATA[$P{startDate}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="160" width="250" height="18" style="BaseBold"/>
                <textFieldExpression><![CDATA[$P{labelEndDate} + ":"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="250" y="160" width="305" height="18"/>
                <textFieldExpression><![CDATA[$P{endDate}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="0" y="180" width="250" height="18" style="BaseBold"/>
                <textFieldExpression><![CDATA[$P{labelComment} + ":"]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="250" y="180" width="305" height="18"/>
                <textFieldExpression><![CDATA[$P{comment}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>
    <columnHeader>
        <band height="44">
            <textField>
                <reportElement x="0" y="4" width="555" height="18" style="Section"/>
                <textFieldExpression><![CDATA[$P{labelMaterialsTitle}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="24" width="140" height="16" style="BaseBold">
                    <printWhenExpression><![CDATA[Boolean.TRUE.equals($P{hasMaterials})]]></printWhenExpression>
                </reportElement>
                <textFieldExpression><![CDATA[$P{labelMaterialCode}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="140" y="24" width="280" height="16" style="BaseBold">
                    <printWhenExpression><![CDATA[Boolean.TRUE.equals($P{hasMaterials})]]></printWhenExpression>
                </reportElement>
                <textFieldExpression><![CDATA[$P{labelMaterialName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="420" y="24" width="135" height="16" style="BaseBold">
                    <printWhenExpression><![CDATA[Boolean.TRUE.equals($P{hasMaterials})]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$P{labelQuantity}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="24" width="555" height="16">
                    <printWhenExpression><![CDATA[!Boolean.TRUE.equals($P{hasMaterials})]]></printWhenExpression>
                </reportElement>
                <textFieldExpression><![CDATA[$P{noMaterials}]]></textFieldExpression>
            </textField>
        </band>
    </columnHeader>
    <detail>
        <band height="20">
            <printWhenExpression><![CDATA[Boolean.TRUE.equals($P{hasMaterials})]]></printWhenExpression>
            <textField>
                <reportElement x="0" y="2" width="140" height="16"/>
                <textFieldExpression><![CDATA[$F{materialCode}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="140" y="2" width="280" height="16"/>
                <textFieldExpression><![CDATA[$F{materialName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="420" y="2" width="135" height="16"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{requiredQuantity}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    <summary>
        <band height="200">
            <textField>
                <reportElement x="0" y="10" width="555" height="18" style="Section"/>
                <textFieldExpression><![CDATA[$P{labelTechnologyTitle}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="0" y="32" width="555" height="60" positionType="Float"/>
                <textFieldExpression><![CDATA[$P{technologyText}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="100" width="555" height="18" style="Section" positionType="Float">
                    <printWhenExpression><![CDATA[Boolean.TRUE.equals($P{showMachineSection})]]></printWhenExpression>
                </reportElement>
                <textFieldExpression><![CDATA[$P{labelMachineTitle}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="0" y="122" width="555" height="60" positionType="Float">
                    <printWhenExpression><![CDATA[Boolean.TRUE.equals($P{showMachineSection})]]></printWhenExpression>
                </reportElement>
                <textFieldExpression><![CDATA[$P{machineText}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
